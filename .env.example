# poster-core API keys — copy to .env and fill in what you have.
# Only the providers you actually use need a key.

# Text analysis + gpt-image-1 generation (minimum for the default config)
OPENAI_API_KEY=

# Gemini text analysis + Imagen generation (image_provider="gemini")
GOOGLE_API_KEY=

# Stock photo search (optional — pipeline falls back to AI generation without them)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
